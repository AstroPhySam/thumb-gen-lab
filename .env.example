# Root .env — the ONLY manual config file in this repo.
# Read by docker-compose (dev + prod) for interpolation. Gitignored.
# CI gets these values from GitHub Actions secrets instead (see docs/deploy-civo.md
# and docs/deploy-aws.md).

# --- Required for prod (docker-compose.prod.civo.yml refuses to start without them).
# Ansible renders these on the server from GitHub secrets; you do not edit them
# after deployment.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
DOMAIN=your-domain-or-instance-public-ip

# --- Optional (all have working defaults in the compose files; leave unless
# you know why you need to change them).
# MINIO_BUCKET_ORIGINALS=originals
# MINIO_BUCKET_THUMBNAILS=thumbnails
# REDIS_URL=redis://redis:6379/0
# MINIO_ENDPOINT=minio:9000

# --- Local dev needs nothing. The dev compose file (docker-compose.dev.yml)
# defaults everything, including MINIO_ROOT_USER/PASSWORD to minioadmin.
